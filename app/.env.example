# SAA-C03 Exam Simulator - Environment Variables Example
# Copy this file to .env.local for local development

# Application Info
VITE_APP_NAME=SAA-C03 Exam Simulator
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=AWS Solutions Architect Associate Certification Practice Simulator

# Build Configuration
# VITE_BUILD_MODE=production

# Analytics (Optional - Future)
# VITE_ANALYTICS_ID=your-analytics-id
# VITE_GA_TRACKING_ID=your-google-analytics-id

# Feature Flags (Optional - Future)
# VITE_ENABLE_DARK_MODE=false
# VITE_ENABLE_PWA=false
# VITE_ENABLE_EXPORT_PDF=false

# API Configuration (Optional - Future Backend)
# VITE_API_URL=https://api.saa-c03-simulator.com
# VITE_API_KEY=your-api-key

# Storage Configuration
# VITE_STORAGE_KEY=saa-c03-progress
# VITE_STORAGE_VERSION=1.0

# Debug Mode
# VITE_DEBUG=false
# VITE_SHOW_CONSOLE_LOGS=false

# Exam Configuration (Override defaults)
# VITE_EXAM_DURATION_MINUTES=132
# VITE_QUESTIONS_PER_EXAM=66
# VITE_PASSING_SCORE=720

# Developer Info
# VITE_AUTHOR_NAME=Ian Laurel Pastene
# VITE_AUTHOR_EMAIL=ian@ianlaurelpastene.com
# VITE_AUTHOR_WEBSITE=https://ianlaurelpastene.com

# Deployment
# VITE_VERCEL_URL=${VERCEL_URL}
# VITE_DEPLOYMENT_ENV=${VERCEL_ENV}
